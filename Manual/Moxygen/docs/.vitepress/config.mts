import { defineConfig } from 'vitepress'
import { readdirSync, readFileSync } from 'node:fs'
import { join } from 'node:path'

// The pages are generated by moxygen and sorted into two sections by
// fix_markdown.py: guide/ (the guides) and reference/ (classes, structs and
// enumerations). Each section has its own sidebar. The sidebars are built from
// the files and their front matter.
const docs = join(__dirname, '..')
const referenceDir = join(docs, 'reference')

const guides = ['introduction', 'api-overview', 'threading', 'state', 'communication', 'headless']

function title(file: string): string {
  const text = readFileSync(join(docs, 'guide', file), 'utf8')
  return /^title:\s*"(.*)"$/m.exec(text)?.[1] ?? file
}

function guideItems() {
  return guides.map(g => ({ text: title(`${g}.md`), link: `/guide/${g}` }))
}

function referenceFiles(): string[] {
  return readdirSync(referenceDir).filter(f => f.endsWith('.md'))
}

// The API classes in the order of the API overview; other *API classes follow
const apis = ['VirtualC64', 'API', 'C64API', 'MemoryAPI', 'MemoryDebuggerAPI', 'CPUAPI',
              'CPUDebuggerAPI', 'GuardsAPI', 'CIAAPI', 'SIDAPI', 'VICIIAPI', 'XRayAPI',
              'AudioPortAPI', 'VideoPortAPI', 'ControlPortAPI', 'JoystickAPI', 'MouseAPI',
              'PaddleAPI', 'ExpansionPortAPI', 'UserPortAPI', 'RS232API', 'SerialPortAPI',
              'DatasetteAPI', 'DriveAPI', 'DiskAPI', 'KeyboardAPI', 'RetroShellAPI',
              'RemoteManagerAPI', 'DefaultsAPI']

// Structs and unions, grouped by what they are for. The first matching rule
// decides; the errors are listed under Reference instead.
const structKinds: [string, RegExp][] = [
  ['Configuration', /Config$/],
  ['Info', /Info$/],
  ['Metrics', /(Metrics|Stats)$/],
  ['Commands', /(Cmd|^Command)$/],
  ['Messages', /(Msg|^Message)$/],
  ['Traits', /Traits$/],
  ['Other', /./],
]

function structGroups() {
  const errors = ['CoreError', 'MediaError']
  const structs = referenceFiles().filter(f => /^vc64-/.test(f))
    .filter(f => /^kind:\s*(struct|union)\s*$/m.test(readFileSync(join(referenceDir, f), 'utf8')))
    .map(f => f.replace(/^vc64-|\.md$/g, ''))
    .filter(c => !errors.includes(c))
    .sort((a, b) => a.localeCompare(b))
  const groups = new Map(structKinds.map(([label]) => [label, [] as string[]]))
  for (const c of structs) groups.get(structKinds.find(([, re]) => re.test(c))![0])!.push(c)
  return [...groups].filter(([, list]) => list.length)
    .map(([label, list]) => ({
      text: label,
      collapsed: true,
      items: list.map(c => ({ text: c, link: `/reference/vc64-${c}` })),
    }))
}

function enumItems() {
  return referenceFiles().filter(f => f.startsWith('enum-'))
    .map(f => f.replace(/^enum-|\.md$/g, ''))
    .sort((a, b) => a.localeCompare(b))
    .map(e => ({ text: e, link: `/reference/enum-${e}` }))
}

function apiItems() {
  const classes = referenceFiles().filter(f => /^vc64-/.test(f))
    .map(f => f.replace(/^vc64-|\.md$/g, ''))
    .filter(c => c.endsWith('API') || c === 'VirtualC64')
  const rank = (c: string) => { const i = apis.indexOf(c); return i < 0 ? apis.length : i }
  return classes.sort((a, b) => rank(a) - rank(b) || a.localeCompare(b))
    .map(c => ({ text: c, link: `/reference/vc64-${c}` }))
}

export default defineConfig({
  title: 'VirtualC64',
  description: 'Public API of the VirtualC64 emulation core',
  lang: 'en-US',
  cleanUrls: true,
  outDir: '../build/site',
  markdown: { theme: { light: 'catppuccin-latte', dark: 'catppuccin-mocha' } },
  themeConfig: {
    logo: '/icon.png',
    search: { provider: 'local' },
    nav: [
      { text: 'Guide', link: '/guide/introduction', activeMatch: '^/guide/' },
      { text: 'Reference', link: '/reference/vc64-VirtualC64', activeMatch: '^/reference/' },
    ],
    sidebar: {
      '/guide/': [
        { text: 'The Guide', collapsed: false, items: guideItems() },
      ],
      '/reference/': [
        { text: 'API', collapsed: false, items: apiItems() },
        { text: 'Structs', collapsed: true, items: structGroups() },
        { text: 'Enumerations', collapsed: true, items: enumItems() },
        { text: 'More', collapsed: false, items: [
          { text: 'Types and Enumerations', link: '/reference/vc64' },
          { text: 'CoreError', link: '/reference/vc64-CoreError' },
          { text: 'MediaError', link: '/reference/vc64-MediaError' },
          { text: 'IOError', link: '/reference/utl-IOError' },
          { text: 'AnyFile', link: '/reference/vc64-AnyFile' },
          { text: 'Snapshot', link: '/reference/vc64-Snapshot' },
        ] },
      ],
    },
  },
})
