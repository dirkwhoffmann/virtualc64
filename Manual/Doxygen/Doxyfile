# Doxyfile for the VirtualC64 public API reference
#
# Generate the documentation with "make" (or "doxygen Doxyfile") in this directory.
# Only the headers that make up the public API are listed in INPUT. Everything
# below them (components, internals) is deliberately left out.

PROJECT_NAME           = "VirtualC64"
PROJECT_NUMBER         = "v5.0 beta"
PROJECT_BRIEF          = "Commodore 64 Emulator"
PROJECT_LOGO           = images/icon.png
OUTPUT_DIRECTORY       = build
CREATE_SUBDIRS         = NO
OPTIMIZE_OUTPUT_FOR_C  = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
TAB_SIZE               = 4

# What to extract
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
HIDE_SCOPE_NAMES       = YES
SORT_MEMBER_DOCS       = NO
SHOW_INCLUDE_FILES     = NO
GENERATE_TODOLIST      = NO
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = NO
GENERATE_DEPRECATEDLIST= NO

# Diagnostics
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"

# Input
INPUT                  = groups.dox \
                         build/guides \
                         ../../VCCore/VirtualC64.h \
                         ../../VCCore/VirtualC64Types.h \
                         ../../VCCore/Components/C64Types.h \
                         ../../VCCore/Components/CIA/CIATypes.h \
                         ../../VCCore/Components/CIA/TODTypes.h \
                         ../../VCCore/Components/CPU/CPUTypes.h \
                         ../../VCCore/Components/CPU/Peddle/PeddleDebuggerTypes.h \
                         ../../VCCore/Components/Memory/MemoryTypes.h \
                         ../../VCCore/Components/SID/SIDTypes.h \
                         ../../VCCore/Components/VICII/BusTypes.h \
                         ../../VCCore/Components/VICII/VICIITypes.h \
                         ../../VCCore/Components/VICII/XRayTypes.h \
                         ../../VCCore/Infrastructure/CmdQueueTypes.h \
                         ../../VCCore/Infrastructure/Constants.h \
                         ../../VCCore/Infrastructure/CoreComponentTypes.h \
                         ../../VCCore/Infrastructure/CoreError.h \
                         ../../VCCore/utlib/include/utl/io/IOError.h \
                         ../../VCCore/utlib/include/utl/types/Exception.h \
                         ../../VCCore/Infrastructure/EmulatorTypes.h \
                         ../../VCCore/Infrastructure/HostTypes.h \
                         ../../VCCore/Infrastructure/MsgQueueTypes.h \
                         ../../VCCore/Infrastructure/OptionTypes.h \
                         ../../VCCore/Infrastructure/ThreadTypes.h \
                         ../../VCCore/Media/AnyFile.h \
                         ../../VCCore/Media/Cartridges/CartridgeTypes.h \
                         ../../VCCore/Media/MediaFileTypes.h \
                         ../../VCCore/Media/MediaError.h \
                         ../../VCCore/Media/Snapshot.h \
                         ../../VCCore/Misc/RemoteServers/RemoteManagerTypes.h \
                         ../../VCCore/Misc/RemoteServers/RemoteServerTypes.h \
                         ../../VCCore/Misc/RetroShell/RetroShellTypes.h \
                         ../../VCCore/Peripherals/Datasette/DatasetteTypes.h \
                         ../../VCCore/Peripherals/Drive/DiskAnalyzerTypes.h \
                         ../../VCCore/Peripherals/Drive/DriveTypes.h \
                         ../../VCCore/Peripherals/Drive/FloppyDiskTypes.h \
                         ../../VCCore/Peripherals/Drive/ParallelCableTypes.h \
                         ../../VCCore/Peripherals/Joystick/JoystickTypes.h \
                         ../../VCCore/Peripherals/Keyboard/C64Key.h \
                         ../../VCCore/Peripherals/Keyboard/KeyboardTypes.h \
                         ../../VCCore/Peripherals/Monitor/MonitorTypes.h \
                         ../../VCCore/Peripherals/Mouse/MouseTypes.h \
                         ../../VCCore/Peripherals/Network/RS232Types.h \
                         ../../VCCore/Peripherals/Paddle/PaddleTypes.h \
                         ../../VCCore/Ports/AudioPortTypes.h \
                         ../../VCCore/Ports/ControlPortTypes.h \
                         ../../VCCore/Ports/ExpansionPortTypes.h \
                         ../../VCCore/Ports/PowerPortTypes.h \
                         ../../VCCore/Ports/UserPortTypes.h \
                         ../../VCCore/Ports/VideoPortTypes.h
FILE_PATTERNS          = *.h *.dox *.md
USE_MDFILE_AS_MAINPAGE = build/guides/index.md
RECURSIVE              = NO
EXAMPLE_PATH           = ../../VCCore
IMAGE_PATH             = guides/images

# The headers use C++20; the macros below only matter for a few attributes
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = "__cplusplus=202002L"

# HTML output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_HEADER            = header.html
HTML_EXTRA_STYLESHEET  = doxygen-awesome/doxygen-awesome.css \
                         doxygen-awesome/doxygen-awesome-sidebar-only.css \
                         doxygen-awesome/doxygen-awesome-sidebar-only-darkmode-toggle.css \
                         doxygen-awesome/custom.css
HTML_EXTRA_FILES       = doxygen-awesome/doxygen-awesome-darkmode-toggle.js
HTML_COLORSTYLE        = LIGHT
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
HTML_DYNAMIC_MENUS     = YES
HTML_CODE_FOLDING      = YES
HTML_COPY_CLIPBOARD    = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
DISABLE_INDEX          = NO

# Other output formats
GENERATE_LATEX         = NO

# XML output (input for sourcey)
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
STRIP_FROM_PATH        = ../../VCCore
STRIP_FROM_INC_PATH    = ../../VCCore

# Diagrams
HAVE_DOT               = NO
EXCLUDE_SYMBOLS        = *Enum *::Enum vc64::TransportDelegate
DOT_IMAGE_FORMAT       = svg
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
GENERATE_LEGEND        = NO
HIDE_UNDOC_RELATIONS   = YES
